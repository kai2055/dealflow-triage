# Copy this file to .env and fill in the key. .env is never committed (it is in .gitignore).
TRIAGE_BASE_URL=https://openrouter.ai/api/v1
TRIAGE_MODEL=anthropic/claude-sonnet-5.5
TRIAGE_API_KEY=

# Optional: these are the defaults
TRIAGE_OUTPUT_MODE=strict
TRIAGE_TEMPERATURE=0
TRIAGE_DATA_COLLECTION=deny
TRIAGE_TIMEOUT_SECONDS=180
TRIAGE_MAX_RETRIES=2